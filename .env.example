# Reference only: this project reads process environment variables, not .env files.
# Generate your own DJANGO_SECRET_KEY; do not copy a shared example key.
DJANGO_SECRET_KEY=replace-with-a-new-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
INTERNAL_API_BASE=http://127.0.0.1:8000
# For a private/local certificate authority, set a local PEM trust-bundle path:
# INTERNAL_API_CA_BUNDLE=/absolute/path/to/local-ca.pem
